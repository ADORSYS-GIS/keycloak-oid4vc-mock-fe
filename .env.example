VITE_KEYCLOAK_URL=https://your-keycloak-instance.com
VITE_KEYCLOAK_REALM=your-realm
VITE_KEYCLOAK_CLIENT_ID=your-client-id
VITE_OID4VC_DEFAULT_CREDENTIAL_CONFIGURATION_ID=your-credential-config-id
VITE_OID4VC_PRE_AUTHORIZED=false

# Base path under which the app is served (must start and end with "/").
# Use "/" when serving from the domain root, e.g. "/mock-fe/" for a
# reverse-proxy deployment under https://example.com/mock-fe/.
VITE_BASE_PATH=/
